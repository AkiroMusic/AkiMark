{
  "name": "akimark",
  "version": "0.2.0",
  "description": "AkiMark - 轻量级屏幕标注工具（Ethereal Glass）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "tauri": "tauri",
    "dev": "tauri dev",
    "dev:fe": "vite",
    "build": "tauri build",
    "build:fe": "vue-tsc --noEmit && vite build",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,vue,css}\" \"*.{ts,json}\"",
    "icon": "node scripts/gen-icon.mjs"
  },
  "devDependencies": {
    "@tauri-apps/api": "^2.11.1",
    "@tauri-apps/cli": "^2",
    "@vitejs/plugin-vue": "^6.0.6",
    "prettier": "^3.8.3",
    "typescript": "^6.0.2",
    "vite": "^8.0.0",
    "vitest": "^3.2.4",
    "vue": "^3.5.30",
    "vue-tsc": "^3.2.6"
  },
  "dependencies": {
    "@tauri-apps/plugin-dialog": "^2.7.2"
  }
}
